{
  "name": "@skyvist/adaptive-status-bar",
  "version": "0.1.2",
  "description": "Native adaptive status bar for React Native, without Expo.",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "author": "Skyvist (adapted from rbayuokt)",
  "homepage": "https://github.com/milosdelibasic/adaptive-status-bar#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.86.0"
  },
  "codegenConfig": {
    "name": "SkyvistAdaptiveStatusBarSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.skyvist.adaptivestatusbar"
    },
    "ios": {
      "modulesProvider": {
        "SkyvistAdaptiveStatusBar": "SkyvistAdaptiveStatusBar"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosdelibasic/adaptive-status-bar.git"
  },
  "bugs": {
    "url": "https://github.com/milosdelibasic/adaptive-status-bar/issues"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "files": [
    "src",
    "!src/**/__tests__/**",
    "ios",
    "!ios/Tests/**",
    "android/build.gradle",
    "android/src/main",
    "SkyvistAdaptiveStatusBar.podspec",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "jest --runInBand --watchman=false",
    "typecheck": "tsc --noEmit",
    "test:ios": "sh scripts/test-ios-core.sh",
    "test:android": "sh scripts/test-android-core.sh"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "typescript": "5.9.3"
  }
}
